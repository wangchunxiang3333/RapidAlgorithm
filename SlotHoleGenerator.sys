MODULE SlotHoleGenerator(SYSMODULE)
    
    PROC MoveSlotHole(robtarget pLine1_Start,
                 robtarget pLine1_End,
                 robtarget pLine2_Ref,
                 speeddata Speed,
                 zonedata Zone,
                 PERS tooldata Tool
                 \PERS wobjdata WObj
                 \PERS loaddata TLoad)
        ! 局部变量定义
        VAR robtarget pLine2_Start;
        VAR robtarget pLine2_End; ! 第二条直线的起止点
        VAR robtarget pZero;
        VAR robtarget pArc1_Center;
        VAR robtarget pArc2_Center; ! 两端圆弧的圆心
        
        VAR pose frame1;
        VAR wobjdata wobj1;
        VAR pose poseLine1_Start;
        VAR pose poseLine1_End; ! 第一条直线的起止点
        VAR pose poseLine2_Start;
        VAR pose poseLine2_End; ! 第二条直线的起止点
        VAR pose poseArc1_Center;
        VAR pose poseArc2_Center; ! 两端圆弧的圆心
        VAR num dWidth;           ! 腰型孔宽度（圆弧直径）
        VAR num dLength;          ! 腰型孔长度（直线长度）
        VAR num rArc;             ! 圆的半径
        
        ! 1. 通过示教的三个点生成一个新的坐标系
        frame1 := DefFrame (pLine1_Start, pLine1_End, pLine2_Ref);
        wobj1.oframe:=frame1;
                
        ! 2.计算腰型孔宽度和长度（第一条直线到参考点的垂直距离）
        dWidth:=PointToLineDistance(pLine1_Start, pLine1_End, pLine2_Ref);
        dLength:=TwoPointsDistance(pLine1_Start, pLine1_End);
        rArc := dWidth / 2; ! 圆弧半径 = 宽度/2
        
        ! 3. 计算第二条直线的起止点（平行于第一条直线）
        ! 第一条直线起点
        poseLine1_Start:=PoseMult(frame1,[[0,0,0],[1,0,0,0]]);
        poseLine1_End:=PoseMult(frame1,[[dLength,0,0],[1,0,0,0]]);
        ! 第二条直线起点（与第一条直线起点平行）
        poseLine2_End:=PoseMult(frame1,[[0,dWidth,0],[1,0,0,0]]);
        poseLine2_Start:=PoseMult(frame1,[[dLength,dWidth,0],[1,0,0,0]]);
        ! 更新点位数据
        pLine2_Start.trans:=poseLine2_Start.trans; 
        pLine2_Start.rot:=pLine1_Start.rot;
        pLine2_Start.robconf:=pLine1_Start.robconf; 
        pLine2_Start.extax:=pLine1_Start.extax;
        pLine2_End.trans:=poseLine2_End.trans;
        pLine2_End.rot:=pLine1_Start.rot;
        pLine2_End.robconf:=pLine1_Start.robconf;
        pLine2_End.extax:=pLine1_Start.extax;
        
        ! 4. 计算两端半圆弧的圆心和过渡点（2D/3D通用）
        ! 右端圆弧（连接Line1_End和Line2_End）
        poseArc1_Center:=PoseMult(frame1,[[dLength+rArc,rArc,0],[1,0,0,0]]);
        pArc1_Center.trans := poseArc1_Center.trans; ! 圆弧圆心
        pArc1_Center.rot := pLine1_Start.rot;     
        pArc1_Center.robconf:=pLine1_Start.robconf;     ! 继承姿态
        pArc1_Center.extax:=pLine1_Start.extax;         ! 继承姿态
        
        ! 左端圆弧（连接Line2_Start和Line1_Start）
        poseArc2_Center:=PoseMult(frame1,[[-rArc,rArc,0],[1,0,0,0]]);
        pArc2_Center.trans := poseArc2_Center.trans; ! 圆弧圆心
        pArc2_Center.rot := pLine1_Start.rot;     
        pArc2_Center.robconf:=pLine1_Start.robconf;     ! 继承姿态
        pArc2_Center.extax:=pLine1_Start.extax;         ! 继承姿态
        
        ! 5. 生成完整腰型孔运动轨迹（精确定位+平滑过渡）
        TPWrite "Slot hole generated - Length: " + NumToStr(dLength,1) + "mm, Width: " + NumToStr(dWidth,1) + "mm";
        
        ! 移动到第一条直线起点（预定位）
        MoveL pLine1_Start, Speed, Zone, tool;
        
        ! 第一段：直线（Line1_Start → Line1_End）
        MoveL pLine1_End, Speed, Zone, tool;
        
        ! 第二段：半圆弧（Line1_End → Line2_Start）
        MoveC pArc1_Center, pLine2_Start, Speed, Zone, tool;
        
        ! 第三段：直线（Line2_Start → Line2_End）
        MoveL pLine2_End, Speed, Zone, tool;
        
        ! 第四段：半圆弧（Line2_End → Line1_Start）
        MoveC pArc2_Center, pLine1_Start, Speed, Zone, tool;
    ENDPROC
    
    FUNC num PointToLineDistance(robtarget pLinePoint1, robtarget pLinePoint2, robtarget pTargetPoint)
        ! 局部变量定义
        VAR pos p1;
        VAR pos p2;
        VAR pos p3;       ! 提取XYZ坐标（仅位置）
        VAR pos vAB;
        VAR pos vAP;         ! 向量（AB:直线方向；AP:点到直线起点）
        VAR pos vCross;           ! 叉乘结果向量
        VAR num lenAB;            ! 直线方向向量的模长
        VAR num lenCross;         ! 叉乘向量的模长
        VAR num distance;         ! 最终距离
        
        ! 1. 提取点位的XYZ坐标（忽略姿态，仅处理位置）
        p1 := pLinePoint1.trans;
        p2 := pLinePoint2.trans;
        p3 := pTargetPoint.trans;
        
        ! 2. 计算直线方向向量AB和点到直线起点向量AP
        vAB.x := p2.x - p1.x;
        vAB.y := p2.y - p1.y;
        vAB.z := p2.z - p1.z;
        
        vAP.x := p3.x - p1.x;
        vAP.y := p3.y - p1.y;
        vAP.z := p3.z - p1.z;
        
        ! 3. 防错：直线两点重合（模长为0）
        lenAB := SQRT(Pow(vAB.x,2) + Pow(vAB.y,2) + Pow(vAB.z,2));
        IF lenAB < 0.001 THEN
            TPWrite "Error: Two line points are the same!";
            RETURN 0; ! 返回0表示计算失败
        ENDIF
        
        ! 4. 计算向量叉乘 AB × AP
        vCross.x := vAB.y * vAP.z - vAB.z * vAP.y;
        vCross.y := vAB.z * vAP.x - vAB.x * vAP.z;
        vCross.z := vAB.x * vAP.y - vAB.y * vAP.x;
        
        ! 5. 计算叉乘向量的模长
        lenCross := SQRT(Pow(vCross.x,2) + Pow(vCross.y,2) + Pow(vCross.z,2));
        
        ! 6. 计算点到直线的垂直距离
        distance := lenCross / lenAB;
        
        ! 输出调试信息（可选）
        TPWrite "Point to line distance: " + NumToStr(distance,2) + " mm";
        
        RETURN distance;
    ENDFUNC
    
    FUNC num TwoPointsDistance(robtarget pPoint1, robtarget pPoint2)
        ! 局部变量：提取点位的XYZ坐标（仅位置，忽略姿态）
        VAR pos p1;
        VAR pos p2;
        
        ! 局部变量：存储距离计算结果
        VAR num dx;
        VAR num dy;
        VAR num dz;  ! 各轴方向的差值
        VAR num distance;    ! 最终距离
        
        p1 := pPoint1.trans;
        p2 := pPoint2.trans;
        ! 1. 计算XYZ三个方向的坐标差值
        dx := p2.x - p1.x;
        dy := p2.y - p1.y;
        dz := p2.z - p1.z;
        
        ! 2. 计算三维直线距离（勾股定理）
        distance := SQRT(Pow(dx, 2) + Pow(dy, 2) + Pow(dz, 2));
        
        ! 可选：输出调试信息（机器人示教器显示）
        TPWrite "Distance between two points: " + NumToStr(distance, 2) + " mm";
        
        RETURN distance;
    ENDFUNC
ENDMODULE